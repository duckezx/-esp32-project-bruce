name: Build Bruce Firmware

on:
  push:
    branches: [main]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3
      
      - uses: actions/setup-python@v4
        with:
          python-version: '3.9'
      
      - name: Install PlatformIO
        run: pip install platformio
      
      - name: Build firmware
        run: pio run -e esp32-wroom-ssd1306
      
      - name: Prepare artifacts
        run: |
          mkdir release
          cp .pio/build/esp32-wroom-ssd1306/firmware.bin release/Bruce-ESP32-WROOM-SSD1306.bin
      
      - name: Upload artifacts
        uses: actions/upload-artifact@v3
        with:
          name: firmware-build
          path: release/
          retention-days: 30
